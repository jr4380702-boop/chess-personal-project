import os
import colors
import random

e = True

def clear():
    if os.name == 'nt':
        _ = os.system('cls')

def printBoard(board):
    for r in board:
        for c in r:
            if c == "O":
                print(colors.CGREEN, end="")
            if c == "X":
                print(colors.CRED, end="")
            print(c, end="")
            print(colors.CWHITE, end="")
        print()

def game_over(board):
    for r in board:
            for c in r:
                if c == "O":
                    print(colors.CRED, end="")
                if c == "X":
                    print(colors.CRED, end="")
                print(c, end="")
                print(colors.CWHITE, end="")
            print()

